# ─────────────────────────────────────────────────────────────
# Kafka Platform — Environment Template
# Copy to `.env` and adjust:
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Phase 1: Producer ──
# Host machine → localhost:9092 | Docker → kafka:29092
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=user-events
KAFKA_CLIENT_ID=user-event-producer
KAFKA_ACKS=all
KAFKA_RETRY_MAX=5
KAFKA_RETRY_BACKOFF=250ms
KAFKA_FLUSH_FREQUENCY=50ms
KAFKA_FLUSH_MESSAGES=100
KAFKA_FLUSH_BYTES=1048576

SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_PATH=./schemas/user_event.avsc
SCHEMA_SUBJECT=user-events-value
SCHEMA_TIMEOUT=10s

LOG_LEVEL=info
METRICS_ADDR=:9090
SHUTDOWN_TIMEOUT=15s
NUM_MESSAGES=1

# ── Phase 2: Kafka Connect + Debezium ──
CONNECT_URL=http://localhost:8083

# Source DB credentials (never commit real values)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=production
POSTGRES_USER=debezium
POSTGRES_PASSWORD=change_me_in_prod

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=debezium
MYSQL_PASSWORD=change_me_in_prod

CDC_TOPIC_PREFIX=cdc
CDC_DLQ_REPLICATION_FACTOR=1